# Copy to .env for local development. .env is gitignored - never commit real values.

# Live Claude narration, reranking and SOP generation. Omit entirely to run
# the deterministic offline path (this is what the deployed service does).
# ANTHROPIC_API_KEY=sk-ant-...

# Postgres/Neon. When set AND the ops tables exist, ops_data reads from
# Postgres and the graph uses PostgresSaver so the approval interrupt
# survives a restart. Unset = CSV + InMemorySaver.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Origins allowed to call the API. Defaults to localhost:3000.
# OPS_COPILOT_CORS_ORIGINS=https://your-app.vercel.app

# Force offline mode even when a key is present (used by CI).
# OPS_COPILOT_LLM=stub

# Dense embeddings instead of the TF-IDF default.
# OPS_COPILOT_EMBEDDINGS=voyage
# VOYAGE_API_KEY=...
